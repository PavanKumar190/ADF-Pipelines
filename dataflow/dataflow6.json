{
	"name": "dataflow6",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Employee_Target_File",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Emp_Target_Skey_aggre",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpNo as short,",
				"          {Full Name} as string,",
				"          Salary as short,",
				"          DeptNo as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"select1 aggregate(groupBy(DeptNo),",
				"     Total_Salary_By_Dept = sum(Salary),",
				"          Min_Sal_By_Dept = min(Salary)) ~> aggregate1",
				"source1 keyGenerate(output(employee_key as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 select(mapColumn(",
				"          employee_key,",
				"          EmpNo,",
				"          {Full Name},",
				"          Salary,",
				"          DeptNo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          EmpNo as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Salary as string,",
				"          DeptNo as string,",
				"          DeptName as string,",
				"          Location as string",
				"     ),",
				"     partitionFileNames:['Emp_Target_Skey_aggre.csv'],",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}