{
	"name": "dataflow5",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Emp_Source",
						"type": "DatasetReference"
					},
					"name": "empSource"
				},
				{
					"dataset": {
						"referenceName": "DS_Emp_Target",
						"type": "DatasetReference"
					},
					"name": "empTarget"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Emp_New_Records_Stage_Lookup",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpNo as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Salary as string,",
				"          DeptNo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empSource",
				"source(output(",
				"          EmpNo as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Salary as string,",
				"          DeptNo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empTarget",
				"empSource, empTarget lookup(empSource@EmpNo == empTarget@EmpNo,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 filter(isNull(empTarget@EmpNo)) ~> filter1",
				"filter1 select(mapColumn(",
				"          EmpNo = empSource@EmpNo,",
				"          FirstName = empSource@FirstName,",
				"          LastName = empSource@LastName,",
				"          Salary = empSource@Salary,",
				"          DeptNo = empSource@DeptNo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DeptNo as string,",
				"          DeptName as string,",
				"          Location as string",
				"     ),",
				"     partitionFileNames:['Emp_New_Records_Stage_Lookup.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}