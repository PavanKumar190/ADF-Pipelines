{
	"name": "dataflow4",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Emp_Source",
						"type": "DatasetReference"
					},
					"name": "empSource"
				},
				{
					"dataset": {
						"referenceName": "DS_Emp_Target",
						"type": "DatasetReference"
					},
					"name": "empTarget"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Emp_New_Records_Stage",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmpNo as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Salary as string,",
				"          DeptNo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empSource",
				"source(output(",
				"          EmpNo as string,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Salary as string,",
				"          DeptNo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empTarget",
				"empSource, empTarget exists(empSource@EmpNo == empTarget@EmpNo,",
				"     negate:true,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DeptNo as string,",
				"          DeptName as string,",
				"          Location as string",
				"     ),",
				"     partitionFileNames:['Employees_New_Records_Staging.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}