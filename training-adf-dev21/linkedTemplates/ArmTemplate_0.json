									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vGenderSelection",
										"value": "You Selected Gender as \"Male\""
									}
								}
							],
							"ifTrueActivities": [
								{
									"name": "Var Female",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "vGenderSelection",
										"value": "You Selected Gender as \"Female\""
									}
