						"          {Full Name} as string,",
						"          City as string,",
						"          {Phone No} as string",
						"     ),",
						"     partitionFileNames:['Customers_Stringfy.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
